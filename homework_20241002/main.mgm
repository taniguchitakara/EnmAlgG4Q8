    // Define the finite field
    F := FiniteField(p);

    // Define the polynomial ring
    P<x> := PolynomialRing(F);

    // Define the curve equation
    f := x^5 - 1;

    // Define the hyperelliptic curve
    C := HyperellipticCurve(f);

    // Compute the Cartier representation
    CartierRep := CartierRepresentation(C);

    // Convert CartierRep to a sequence
    CartierSeq := Eltseq(CartierRep);

    // Check if all components of CartierSeq are zero
    allZero := true;
    for comp in CartierSeq do
        if comp ne 0 then
            allZero := false;
            break;
        end if;
    end for;

    // Print the result
    f;
    CartierRep;
    if allZero then
        printf "For p = %o, superspecial\n", p;
    else
        printf "For p = %o, not superspecial\n", p;
    end if;
end for;

// List of prime numbers between 11 and 19
primes := [11, 13, 17, 19];

for p in primes do
    // Define the finite field
    F := FiniteField(p);

    // Define the polynomial ring
    P<x> := PolynomialRing(F);

    // Define the curve equation
    f := x^8 - 14*x^4 + 1;

    // Define the hyperelliptic curve
    C := HyperellipticCurve(f);

    // Compute the Cartier representation
    CartierRep := CartierRepresentation(C);

    // Convert CartierRep to a sequence
    CartierSeq := Eltseq(CartierRep);

    // Check if all components of CartierSeq are zero
    allZero := true;
    for comp in CartierSeq do
        if comp ne 0 then
            allZero := false;
            break;
        end if;
    end for;

    // Print the result
    f;
    CartierRep;
    if allZero then
        printf "For p = %o, superspecial\n", p;
    else
        printf "For p = %o, not superspecial\n", p;
    end if;
end for;