// List of prime numbers between 11 and 19

primes := [p : p in [1..80] | IsPrime(p)];
// Get the genus of the curve
g := 2;
for p in primes do
    count := 0;
    // Define the finite field
    F := FiniteField(p^2);

    // Define the polynomial ring
    P<x,a> := PolynomialRing(F,2);

    // Define the curve equation
    f_powered := (x*(x^4+a*x^2+1))^((p-1) div 2);
    //f_powered;



    // Check if all components of CartierSeq are zero

    for input in [1..p^2] do
        allZero := true;
        // f_powered;
        f_new := Evaluate(f_powered, [x, input]);
        // f_new;
        for i in [1..g] do
            for j in [1..g] do
                CartierRep := Coefficient(f_new,x, p*i-j);
                // printf "%o ", CartierRep;
                if CartierRep ne 0 then
                    allZero := false;
                end if;
            end for;
        end for;
        if allZero eq true then
            count := count + 1;
        end if;
    end for;
    printf "For p = %o, num(a) = %o\n", p,count;

    // Print the result
    // if allZero then
    //    printf "For p = %o, superspecial\n", p;
    //else
    //    //printf "For p = %o, not superspecial\n", p;
    //end if;
end for;