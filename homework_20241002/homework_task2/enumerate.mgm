function CountPrimes(n)
    count1 := 0;
    count2 := 0;
    primes := [s : s in [1..200] | IsPrime(s)];
    for p in primes do
        if p mod 8 eq 5 and p mod 4 eq 1 then
            count1 +:= 1;
        elif p mod 8 eq 7 and p mod 4 eq 3 then
            count2 +:= 1;
        end if;
    end for;
    return count1, count2;
end function;

// 例: n = 100 までの素数を数え上げる
n := 100;
count1, count2 := CountPrimes(n);
printf "5 mod 8 かつ 1 mod 4 の素数の数: %o\n", count1;
printf "7 mod 8 かつ 3 mod 4 の素数の数: %o\n", count2;
