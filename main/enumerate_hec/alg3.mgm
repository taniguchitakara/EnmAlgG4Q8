function cartier_gcd_root(p)
    // Define the finite field
    F := FiniteField(p);

    // Define the polynomial ring
    R<a> := PolynomialRing(F);
    P<x> := PolynomialRing(R);

    // Define the curve equation
    e := Integers()!((p-1)/2);
    f_powered := (x-1)^e*(x+1)^e*(x^2+a*x+1)^e;

    // Check if all components of CartierSeq are zero
    p_mod := p mod 8;
    if p_mod eq 1 or p_mod eq 5 then
        coefficient_list := [Integers()!((n-e)/2): n in [p-1,p-3,2*p-2,2*p-4]];
    else
        coefficient_list := [Integers()!((n-e)/2): n in [p-2,p-4,2*p-1,2*p-3]];
    end if;

    seq := [];
    for coef in coefficient_list do
        CartierRep := Coefficient(f_powered,coef);
        Append(~seq, CartierRep);
    end for;

    gcd_all := GCD(seq);
    differential_gcdall := Derivative(gcd_all);
    if GCD(differential_gcdall,gcd_all) eq 1 then
        return gcd_all;
    end if;
end function;

function enumerate_hec(p,gcd_all)
    F := FiniteField(p^2);
    P<x,b> := PolynomialRing(F,2);
    P<a> := PolynomialRing(F);
    gcd_all := P!gcd_all;
    roots := Roots(gcd_all);
    f := x*(x^4 - 1)*(x^4 + b*x^2 + 1);

    root_list_fld := [t[1] : t in roots];

    NG_list :=[];
    final_list := [];

    for root in root_list_fld do
        // 新しいリストを作成
        if root in NG_list then
            continue;
        else
            element1 := - root;
            element2 := 2 + (16/ (root - 2));
            element3 := -(2 + (16 / (root - 2)));
            element4 :=  2 - (16 / (root+2));
            element5 := - 2 + (16 / (root+2));

            elements_to_remove :=[element1,element2,element3,element4,element5];
            for element_to_remove in elements_to_remove do
                Append(~NG_list,element1);
                Append(~NG_list,element2);
                Append(~NG_list,element3);
                Append(~NG_list,element4);
                Append(~NG_list,element5);
            end for;
        end if;

        if root in NG_list then
            continue;
        else
            Append(~final_list, root);
        end if;
    end for;


    for root in final_list do
        hec := Evaluate(f,[x,root]);
        if root ne 0 or root^2 ne 36 or root^2 ne -12 then
            printf "%o\n", hec;
        end if;
    end for;

    return 0;

end function;

primes := [p : p in [7..10000] | IsPrime(p)];

for p in primes do
    start_time := Realtime();
    gcd_all := cartier_gcd_root(p);
    printf "For p=%o\n",p; 
    none := enumerate_hec(p,gcd_all);
    end_time := Realtime();
    execution_time := end_time - start_time;
    print "Execution time:", execution_time, "seconds\n";
end for;

