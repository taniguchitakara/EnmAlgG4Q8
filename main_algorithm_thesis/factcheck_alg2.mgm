
// List of prime numbers between 11 and 19
function SSPcheck(C)

    CartierRep := CartierRepresentation(C);
    // Convert CartierRep to a sequence
    CartierSeq := Eltseq(CartierRep);
    // Check if all components of CartierSeq are zero
    allZero := true;
    for comp in CartierSeq do
        if comp ne 0 then
            allZero := false;
            break;
        end if;
    end for;
    if allZero then
        return true;
    else
        return false;
    end if;
end function;


primes := [p : p in [3..200] | IsPrime(p)];
// Get the genus of the curve
g := 4;
for p in primes do
    count := 0;
    // Define the finite field
    F := FiniteField(p^2);

    // Define the polynomial ring
    P<x,a> := PolynomialRing(F,2);
    P<z> := PolynomialRing(FiniteField(p^2)); // chenge Type

    // Define the curve equation
    f := x*(x^4-1)*(x^4+a*x^2+1);




    // Check if all components of CartierSeq are zero

    for input in [1..p^2] do
        f_substitute := Evaluate(f, [z, input]);
        try
            // エラーが発生する可能性のあるコード
            H := HyperellipticCurve(f_substitute);
            if IsNonsingular(H) then
                aut := AutomorphismGroupOfHyperellipticCurve(H : geometric:=true);
                name := GroupName(aut);
                if SSPcheck(H) eq true then
                    printf "For p =%o, a = %o, Group %o superspecial\n",p, input, name;
                else
                    printf "For p =%o, a = %o, Group %o non-superspecial\n",p, input, name;
                end if;
            end if;
        catch e
            // printf "For p =%o, a = %o, error\n"p, input;
            printf "";
        end try;
    end for;

end for;


