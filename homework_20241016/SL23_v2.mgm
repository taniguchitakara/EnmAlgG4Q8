primes := [p : p in [13..2000000] | IsPrime(p)];

for p in primes do
    // Define the finite field
    F := FiniteField(p^2);

    // Define the polynomial ring
    P<x> := PolynomialRing(F,2);
    Q<z> := PolynomialRing(F);
    roots := Roots(z^2+12);
    root_list := [r[1] : r in roots];

    for root in root_list do

        f_powered := (x*(x^4 - 1)*(x^4 + root * x^2 + 1))^((p-1) div 2);

        // Get the genus of the curve
        g := 4;

        // Check if all components of CartierSeq are zero

        allZero := true;
        for i in [1..g] do
            for j in [1..g] do
                CartierRep := Coefficient(f_powered, x, p * i - j);
                printf "%o ", CartierRep;
                if CartierRep ne 0 then
                    allZero := false;
                end if;
            end for;
            printf "\n";
        end for;

        // Print the result
        if allZero then
            printf "For p = %o,root = %o, superspecial\n", p, root;
        else
            printf "For p = %o,root = %o not superspecial\n", p, root;
        end if;
    end for;
end for;